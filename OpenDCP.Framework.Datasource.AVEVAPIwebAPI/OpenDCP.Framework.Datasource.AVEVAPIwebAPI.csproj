<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Roche/dcp-pkg-be-dotnet-datasource-avevapiwebapi</RepositoryUrl>
    <PackageProjectUrl>https://open-dcp.ai/</PackageProjectUrl>
    <Version>0.1.0</Version>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenDCP.Framework.Configuration.Model" Version="0.3.0" />
    <PackageReference Include="OpenDCP.Framework.Datasource.Base" Version="0.5.0" />
    <PackageReference Include="OpenDCP.Framework.DataTypes.Equipment" Version="0.3.0" />
    <PackageReference Include="OpenDCP.Framework.HttpClient" Version="0.2.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Templates\DatasourceUnits.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Templates\DeviceSensorsByGroupTemplate.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Templates\ElementMetadata.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Templates\MultiDeviceEventframes.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Templates\PlotDataWithBatchContext.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Templates\SingleDeviceEventframes.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Templates\SingleEventframe.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
	<None Update="Templates\SearchGlobalFilterElements.json">
		<CopyToOutputDirectory>Always</CopyToOutputDirectory>
	</None>
	<None Update="Templates\SensorsDevice.json">
		<CopyToOutputDirectory>Always</CopyToOutputDirectory>
	</None>
  </ItemGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
